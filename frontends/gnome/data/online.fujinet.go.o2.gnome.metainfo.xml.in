<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.o2.gnome</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go Odyssey 2 (GNOME)</name>
  <summary>Odyssey 2 and Videopac with FujiNet</summary>
  <description>
    <p>
      A self-contained Magnavox Odyssey 2 and Philips Videopac, the 1978
      Intel 8048 consoles, with a FujiNet built in: browse a network host from
      the console, boot games and programs over the network, and let a FujiNet
      program keep talking to the network, all in one application.
    </p>
    <p>
      FujiNet's CONFIG program is built in and starts at power-on, exactly as
      on the FujiNet Odyssey 2 cartridge. Local cartridge images can be opened
      in its place, or imported to FujiNet's SD folder with Import Cartridge to
      SD and booted from CONFIG. The console's RESET key restarts whatever the
      cartridge is serving, and Reset to CONFIG ejects the cartridge and brings
      CONFIG back. The Odyssey 2 (NTSC), the Videopac G7000 (PAL) and the
      Videopac+ G7400 (with its text chip) are all here, with The Voice in
      front of the cartridge if you like.
    </p>
    <p>
      The emulator is MAME's Odyssey 2 and Videopac, with the 8048, the 8244
      and 8245 video chips, the G7400's EF9340 and The Voice's speech chip,
      transposed to C, with the FujiNet cartridge running the real cartridge
      firmware's own protocol and page-mapping sources, so it behaves as the
      hardware does.
    </p>
    <p>
      The Controllers window draws the console's membrane keyboard and both
      joysticks; click and hold to press, and Map rebinds any key or stick
      control to a key or a gamepad button. Gamepads are picked up as they are
      plugged in and out. A native debugger has a command prompt, the 8048's
      registers and RAM, disassembly with breakpoints, a Video tab that shows
      everything the 8244 knows (the rendered display with its layers, every
      sprite and character with its position and bitmap, the grid, all 256
      registers, collisions and sound), the EF9340, the I/O ports and keyboard
      matrix, and the FujiNet cartridge with every FujiBus packet on its link.
      Built-in, searchable Help covers all of it.
    </p>
    <p>
      Nothing copyrighted is included. CONFIG and FujiNet programs run on the
      application's own stand-in for the BIOS; Odyssey 2 games call the real
      BIOS, and every machine needs the video chip's character set to show
      text, so you add your own copies with Import BIOS, from files, a zip or a
      folder.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.o2.gnome.desktop</launchable>
  <icon type="stock">online.fujinet.go.o2.gnome</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-o2-desktop/issues</url>
  <url type="vcs-browser">https://github.com/FujiNetWIFI/fujinet-go-o2-desktop</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>The FujiNet CONFIG client running on the console</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-o2-desktop/v0.1.0/data/screenshots/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger's Video tab, showing the 8244's objects</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-o2-desktop/v0.1.0/data/screenshots/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>The Controllers window: the membrane keyboard and both joysticks</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-o2-desktop/v0.1.0/data/screenshots/3_controllers.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-11-13">
      <description>
        <p>
          Fixed a crash when quitting the app on macOS.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-08">
      <description>
        <p>
          Built-in, searchable Help: Help menu (Ctrl+Shift+H, ⌘? on a Mac) and Help buttons in Preferences, the debugger and the console log open the topic for what they show.
        </p>
      </description>
    </release>
    <release version="0.1.2" date="2026-11-07">
      <description>
        <p>
          Fixed a freeze when a gamepad trigger was pressed with the Controllers window open.
        </p>
      </description>
    </release>
    <release version="0.1.1" date="2026-11-02">
      <description>
        <p>
          The CONFIG client's start-up splash now shows the FujiNet logo.
          0.1.0 embedded an earlier CONFIG whose logo was wrong.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-02">
      <description>
        <p>
          First release: the Magnavox Odyssey 2, the Philips Videopac G7000
          and the Videopac+ G7400 transposed from MAME, with the FujiNet
          Odyssey 2 cartridge and an in-process FujiNet; a Controllers window
          with the console's keyboard and both joysticks, hotplugged gamepads,
          Import BIOS from files, a zip or a folder, and a native debugger with
          a full 8244 video tab and a FujiNet tab showing every FujiBus packet.
        </p>
      </description>
    </release>
  </releases>
</component>
